# ───────────────────────────────────────────
# AgentOS Pro — Agent Mode environment
# ───────────────────────────────────────────

# Default model when no explicit choice is made
AGENT_DEFAULT_MODEL=claude-opus-4-7

# Anthropic — for Claude (and native Computer Use)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# DeepSeek — OpenAI-compatible API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI — GPT-4o, GPT-5, etc.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxx

# Google Gemini
GEMINI_API_KEY=xxxxxxxxxxxxxxxxx

# Ollama — local models
OLLAMA_BASE_URL=http://localhost:11434/v1

# ───────────────────────────────────────────
# Agent runtime
# ───────────────────────────────────────────
AGENT_MAX_ITERATIONS=25
AGENT_SCREENSHOT_ON_EVERY_STEP=true
AGENT_REQUIRE_CONFIRMATION_FOR=download,purchase,delete,financial

# AgentOS frontend environment variables
# Copy this file to .env and fill in the values you need.

# Backend API base URL for agent mode and backend-assisted chat.
VITE_API_BASE_URL=http://localhost:8000

# LLM Provider API Keys
# These are configured through the Settings UI, not through env vars.
# The app stores API keys in localStorage for direct browser-to-API calls.
# For production deployments, use a backend proxy to keep keys secure.

# If you want to pre-configure keys server-side instead:
# VITE_ANTHROPIC_API_KEY=
# VITE_OPENAI_API_KEY=
# VITE_DEEPSEEK_API_KEY=
# VITE_GOOGLE_API_KEY=
# VITE_MISTRAL_API_KEY=
# VITE_GROQ_API_KEY=

# Local model servers
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234
